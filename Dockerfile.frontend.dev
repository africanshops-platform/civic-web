FROM node:22-alpine
WORKDIR /app

# Install deps from lockfile (node_modules stays in image — not bind-mounted)
COPY package.json yarn.lock ./
RUN corepack enable && yarn install --ignore-scripts

# Copy all root-level config files Vite needs at runtime
# (src/ and public/ are bind-mounted at runtime for hot-reload)
COPY index.html vite.config.mjs jsconfig.json aliases.js \
     tailwind.config.js postcss.config.mjs ./
COPY public ./public

# CMD overridden per service in docker-compose.frontend.dev.yml
